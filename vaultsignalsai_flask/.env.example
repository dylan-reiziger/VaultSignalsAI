ADMIN_PASSWORD_ROTATION_CHECK_INTERVAL_SECONDS=300
ADMIN_PASSWORD_LENGTH=24
SECURITY_PANEL_ENABLED=true
SECURITY_PANEL_ADMIN_USERNAME=admin
