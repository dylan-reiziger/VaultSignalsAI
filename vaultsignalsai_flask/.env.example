SECURITY_PANEL_ADMIN_PASSWORD_HASH_AFTER_FREEZE=
SECURITY_CONSOLE_STEALTH_MODE=true
SECURITY_CONSOLE_NO_CACHE=true

REQUEST_TIMEOUT_SECONDS=5
REQUEST_RETRIES=2

